# Copy this file to .env on macOS and edit only if your paths/ports are different.

# Nmap installed from the official macOS app/pkg.
NMAP_PATH=/Applications/nmap.app/Contents/Resources/bin/nmap

# Backend settings
HOST_DISCOVERY_PORT=4000

# Scan settings
BASIC_SCAN_COMMON_PORTS=21,22,23,25,53,80,110,135,139,143,389,443,445,465,587,993,995,1433,1521,3306,3389,5000,5432,5900,6379,7000,8080,8443,27017
FULL_SCAN_PORT_RANGE=1-10000
DISCOVERY_TIMEOUT_MS=450
DISCOVERY_MAX_HOSTS=512
DISCOVERY_MAX_PORTS=10000
PORT_SCAN_CONCURRENCY=200
NMAP_SERVICE_TIMEOUT_MS=90000
